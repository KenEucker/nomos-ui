---
import { Toaster } from "./ui/sonner"
const { title = "Nomos Admin" } = Astro.props
const path = Astro.url.pathname
---

<div class="min-h-screen bg-background text-foreground">
  <input id="nav-toggle" type="checkbox" class="peer sr-only" />

  <header class="flex items-center justify-between border-b bg-card px-6 py-4 md:hidden">
    <label for="nav-toggle" class="text-sm font-semibold">Menu</label>
    <div class="text-sm font-medium text-muted-foreground">{title}</div>
  </header>

  <label
    for="nav-toggle"
    class="pointer-events-none fixed inset-0 z-20 bg-black/30 opacity-0 transition peer-checked:pointer-events-auto peer-checked:opacity-100 md:hidden"
  ></label>

  <div class="flex">
    <aside
      class="fixed inset-y-0 left-0 z-30 w-64 -translate-x-full border-r bg-sidebar px-4 py-6 shadow-sm transition-transform peer-checked:translate-x-0 md:sticky md:translate-x-0"
    >
      <div class="mb-6 text-sm font-semibold">Nomos Admin</div>
      <nav class="space-y-2 text-sm">
        <a
          href="/"
          class={`block rounded-md px-3 py-2 hover:bg-sidebar-accent ${
            path === "/" ? "bg-sidebar-accent font-semibold" : ""
          }`}
        >
          Home
        </a>
        <a
          href="/diagnostics"
          class={`block rounded-md px-3 py-2 hover:bg-sidebar-accent ${
            path === "/diagnostics" ? "bg-sidebar-accent font-semibold" : ""
          }`}
        >
          Diagnostics
        </a>
        <a
          href="/users"
          class={`block rounded-md px-3 py-2 hover:bg-sidebar-accent ${
            path === "/users" ? "bg-sidebar-accent font-semibold" : ""
          }`}
        >
          Users
        </a>
        <a
          href="/settings"
          class={`block rounded-md px-3 py-2 hover:bg-sidebar-accent ${
            path === "/settings" ? "bg-sidebar-accent font-semibold" : ""
          }`}
        >
          Settings
        </a>
      </nav>
    </aside>

    <div class="flex-1 px-6 py-6 md:ml-64">
      <slot />
    </div>
  </div>

  <Toaster client:load />
</div>
