---
import type { PanelCtx, PanelModule, PanelRenderContext } from "../lib/types"
import PanelRuntime from "./PanelRuntime.svelte"

const { panel, mode = "page" } = Astro.props as { panel: PanelModule<any>; mode?: "page" | "embed" | "modal" }

const ctx: PanelCtx = {
  request: Astro.request,
  url: Astro.url,
}

const renderCtx: PanelRenderContext = {
  mode,
  url: Astro.url,
}

let initialData: any = null
let initialError: string | null = null

try {
  initialData = panel.load ? await panel.load(ctx) : null
} catch (e: any) {
  initialError = e?.message ?? String(e)
}
---

<!--
  PanelRuntime is THE island.
  Everything interactive lives inside it.
-->
<PanelRuntime
  client:load
  panelId={panel.id}
  title={panel.title}
  subtitle={panel.subtitle}
  initialData={initialData}
  initialError={initialError}
  context={renderCtx}
/>
