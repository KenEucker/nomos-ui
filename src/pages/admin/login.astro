---
import "../../styles/global.css"
import { SUBJECTS } from "$lib/auth/subject"

const redirectTo = Astro.url.searchParams.get("redirect") ?? "/admin/users"
---

<div class="min-h-screen bg-background text-foreground">
  <div class="mx-auto flex max-w-3xl flex-col gap-6 px-6 py-12">
    <div>
      <h1 class="text-3xl font-semibold">Admin login</h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Select a demo subject to preview authorization behavior.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {SUBJECTS.map((subject) => (
        <a
          class="rounded-xl border border-border bg-card p-5 shadow-sm transition hover:border-ring/60 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
          href={`/admin/login?as=${subject.level}&redirect=${encodeURIComponent(redirectTo)}`}
        >
          <div class="text-lg font-semibold text-foreground">{subject.name}</div>
          <div class="mt-1 text-sm text-muted-foreground">{subject.email}</div>
          <div class="mt-3 inline-flex rounded-full bg-muted px-2 py-1 text-xs font-medium text-muted-foreground">
            {subject.level}
          </div>
        </a>
      ))}
    </div>
  </div>
</div>
