---
import "../../styles/global.css"

const links = [
  { label: "Users", href: "/admin/users", description: "Manage workspace users." },
  { label: "Roles", href: "/admin/roles", description: "Define permission bundles." },
  { label: "Permissions", href: "/admin/permissions", description: "Review available permissions." },
]
---

<div class="min-h-screen bg-background text-foreground">
  <div class="mx-auto max-w-4xl px-6 py-12">
    <div class="space-y-6">
      <div>
        <h1 class="text-3xl font-semibold">Admin</h1>
        <p class="mt-2 text-sm text-muted-foreground">Choose an admin area to manage.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {links.map((link) => (
          <a
            class="rounded-xl border border-border bg-card p-5 shadow-sm transition hover:border-ring/60 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
            href={link.href}
          >
            <div class="text-lg font-semibold text-foreground">{link.label}</div>
            <div class="mt-2 text-sm text-muted-foreground">{link.description}</div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
