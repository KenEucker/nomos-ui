---
import "../../styles/global.css"
import { Toaster } from "../../components/ui/sonner"
---

<div class="min-h-screen bg-background text-foreground">
  <div class="mx-auto max-w-5xl px-6 py-12">
    <div class="space-y-2">
      <h1 class="text-3xl font-semibold">Nomos Admin</h1>
      <p class="text-sm text-muted-foreground">Choose a panel to explore the Orchid-style runtime.</p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <a class="rounded-xl border bg-card p-6 hover:bg-muted/30" href="/admin/p/dashboard">
        <h2 class="text-lg font-semibold">Dashboard</h2>
        <p class="text-sm text-muted-foreground">Overview stats and build details.</p>
      </a>
      <a class="rounded-xl border bg-card p-6 hover:bg-muted/30" href="/admin/p/resources">
        <h2 class="text-lg font-semibold">Resources</h2>
        <p class="text-sm text-muted-foreground">List and mutate stub resources.</p>
      </a>
    </div>
  </div>
  <Toaster client:load />
</div>
