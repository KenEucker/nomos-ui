---
import ResourcePanelPage from "../../../components/ResourcePanelPage.astro"
import { createResourcePanel } from "$lib/resource-panel"
import { usersResource } from "./users.resource"

const mode = "list"
const params = {}
const basePath = "/admin/users"
const panel = createResourcePanel({ resource: usersResource, mode, params, basePath })
const resourceConfig = { resource: usersResource, mode, params, basePath }
---

<ResourcePanelPage panel={panel} resourceConfig={resourceConfig} />
